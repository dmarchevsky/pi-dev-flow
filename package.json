{
	"name": "pi-dev-flow",
	"version": "0.65.0",
	"description": "Enforced feature workflow for Pi: plan → implement → pre-release → release, gated checkpoints, self-improvement reflections, one git worktree per feature, changelog + publish as part of the release",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi",
		"pi-coding-agent",
		"extension",
		"workflow",
		"dev-flow",
		"spec",
		"plan",
		"release",
		"semver",
		"changelog",
		"git-worktree",
		"guardrails"
	],
	"license": "MIT",
	"repository": "https://github.com/dmarchevsky/pi-dev-flow",
	"engines": {
		"node": ">=22.19.0"
	},
	"files": [
		"extensions/",
		"src/",
		"skills/",
		"docs/",
		"banner.svg",
		"banner.png",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./extensions/dev-flow.ts"
		],
		"skills": [
			"./skills"
		],
		"image": "./banner.png"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"@types/node": "^22.0.0",
		"typescript": "^7.0.2"
	},
	"scripts": {
		"build": "tsc --noEmit",
		"test": "node --test"
	}
}
